#Machine Upgrade Settings
[Upgrades]

	[Upgrades.basic_batch_upgrade]
		#Bonus value (e.g. batch counts or extra stacks).
		# Default: 0.5
		# Range: 0.0 ~ 10000.0
		value = 0.5
		#Max amount of this upgrade that can be installed in a single machine.
		# Default: 16
		# Range: 1 ~ 64
		maxLimit = 16
		#Energy penalty per installed upgrade (e.g. 0.05 = +5% energy use).
		# Default: 0.05000000074505806
		# Range: 0.0 ~ 100.0
		energyPenalty = 0.05000000074505806

	[Upgrades.crystalline_batch_upgrade]
		#Bonus value (e.g. batch counts or extra stacks).
		# Default: 2.0
		# Range: 0.0 ~ 10000.0
		value = 2.0
		#Max amount of this upgrade that can be installed in a single machine.
		# Default: 8
		# Range: 1 ~ 64
		maxLimit = 8
		#Energy penalty per installed upgrade (e.g. 0.05 = +5% energy use).
		# Default: 0.10000000149011612
		# Range: 0.0 ~ 100.0
		energyPenalty = 0.10000000149011612

